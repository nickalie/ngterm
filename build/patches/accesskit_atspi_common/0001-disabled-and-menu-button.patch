+#[cfg(test)]
+mod state_tests {
+    use accesskit::{
+        HasPopup, Node as NodeData, NodeId as LocalNodeId, Role, Toggled, Tree as TreeData, TreeId,
+        TreeUpdate,
+    };
+    use accesskit_consumer::Tree;
+    use atspi_common::{Role as AtspiRole, State};
+
+    use super::NodeWrapper;
+
+    /// A window holding `child`; the child's AT-SPI role and state.
+    fn mapped(child: NodeData) -> (AtspiRole, atspi_common::StateSet) {
+        let mut window = NodeData::new(Role::Window);
+        window.set_children(vec![LocalNodeId(1)]);
+        let tree = Tree::new(
+            TreeUpdate {
+                nodes: vec![(LocalNodeId(0), window), (LocalNodeId(1), child)],
+                tree: Some(TreeData::new(LocalNodeId(0))),
+                tree_id: TreeId::ROOT,
+                focus: LocalNodeId(0),
+            },
+            false,
+        );
+        let state = tree.state();
+        let node = state.root().children().next().unwrap();
+        let wrapper = NodeWrapper(&node);
+        (wrapper.role(), wrapper.state(false))
+    }
+
+    #[test]
+    fn a_disabled_button_is_neither_enabled_nor_sensitive() {
+        let (_, enabled) = mapped(NodeData::new(Role::Button));
+        assert!(enabled.contains(State::Enabled) && enabled.contains(State::Sensitive));
+        let mut button = NodeData::new(Role::Button);
+        button.set_disabled();
+        let (_, disabled) = mapped(button);
+        assert!(!disabled.contains(State::Enabled) && !disabled.contains(State::Sensitive));
+        assert!(!disabled.contains(State::ReadOnly));
+    }
+
+    #[test]
+    fn a_read_only_field_stays_enabled_and_a_disabled_one_is_not_editable() {
+        let mut field = NodeData::new(Role::TextInput);
+        field.set_read_only();
+        let (_, read_only) = mapped(field);
+        assert!(read_only.contains(State::ReadOnly) && read_only.contains(State::Enabled));
+        assert!(!read_only.contains(State::Editable));
+        let mut field = NodeData::new(Role::TextInput);
+        field.set_disabled();
+        let (_, disabled) = mapped(field);
+        assert!(!disabled.contains(State::Editable) && !disabled.contains(State::Enabled));
+        let (_, editable) = mapped(NodeData::new(Role::TextInput));
+        assert!(editable.contains(State::Editable) && editable.contains(State::Enabled));
+    }
+
+    #[test]
+    fn a_button_with_a_menu_is_a_push_button_menu() {
+        let mut button = NodeData::new(Role::Button);
+        button.set_has_popup(HasPopup::Menu);
+        let (role, state) = mapped(button);
+        assert_eq!(role, AtspiRole::PushButtonMenu);
+        assert!(state.contains(State::HasPopup));
+        let mut toggle = NodeData::new(Role::Button);
+        toggle.set_has_popup(HasPopup::Menu);
+        toggle.set_toggled(Toggled::False);
+        assert_eq!(mapped(toggle).0, AtspiRole::ToggleButton);
+        assert_eq!(mapped(NodeData::new(Role::Button)).0, AtspiRole::Button);
+    }
+}
