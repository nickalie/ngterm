Record platform IME coordinate pushes in the GPUI test window.

VisualTestContext::ime_positions exposes the actual update_ime_position sink, so
terminal focus-switch and output regressions check delivery to the platform.

diff -ruN a/src/app/test_context.rs b/src/app/test_context.rs
--- a/src/app/test_context.rs
+++ b/src/app/test_context.rs
@@ -1060,6 +1060,11 @@
         self.background_executor.run_until_parked();
     }
 
+    /// Cursor rectangles actually pushed to the platform IME, in order.
+    pub fn ime_positions(&self) -> Vec<Bounds<Pixels>> {
+        self.cx.test_window(self.window).ime_positions()
+    }
