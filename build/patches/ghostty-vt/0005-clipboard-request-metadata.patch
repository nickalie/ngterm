Subject: [PATCH] Expose clipboard request origin and effective password as data

ngterm defers native writes outside its VT lock and keeps token grants in Rust.
No callback lifetime, parser, grant or acknowledgement logic changes.

--- a/src/terminal/clipboard.zig
+++ b/src/terminal/clipboard.zig
@@ -1,4 +1,7 @@
 const std = @import("std");
+
+/// The protocol that produced an external clipboard request.
+pub const Origin = enum(c_int) { kitty = 0, osc52 = 1, osc1337 = 2 };
 
 /// The clipboard destination for a write.
 pub const Location = enum(c_int) {
@@ -80,6 +83,8 @@
 /// Contents are borrowed and only valid for the duration of the callback.
 /// An empty contents slice clears the destination.
 pub const Write = struct {
+    pw: []const u8 = "",
