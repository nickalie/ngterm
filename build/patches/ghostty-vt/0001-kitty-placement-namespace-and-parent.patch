+
+/// A placement's key as the C API reports it, for the tests below.
+const TestKey = struct {
+    image_id: u32,
+    placement_id: u32,
+    namespace: PlacementIdNamespace,
+};
+
+fn testIteratorKey(iter: PlacementIterator) !TestKey {
+    var key: TestKey = undefined;
+    try testing.expectEqual(Result.success, placement_get(iter, .image_id, @ptrCast(&key.image_id)));
+    try testing.expectEqual(Result.success, placement_get(iter, .placement_id, @ptrCast(&key.placement_id)));
+    try testing.expectEqual(Result.success, placement_get(iter, .placement_id_namespace, @ptrCast(&key.namespace)));
+    return key;
+}
+
+/// A relative placement's parent link as the C API reports it, null when
+/// every parent field reports no value.
+const TestParent = struct {
+    key: TestKey,
+    horizontal_offset: i32,
+    vertical_offset: i32,
+};
+
+fn testIteratorParent(iter: PlacementIterator) !?TestParent {
+    var parent: TestParent = undefined;
+    const first = placement_get(iter, .parent_image_id, @ptrCast(&parent.key.image_id));
+    const rest = [_]Result{
+        placement_get(iter, .parent_placement_id, @ptrCast(&parent.key.placement_id)),
+        placement_get(iter, .parent_placement_id_namespace, @ptrCast(&parent.key.namespace)),
+        placement_get(iter, .relative_horizontal_offset, @ptrCast(&parent.horizontal_offset)),
+        placement_get(iter, .relative_vertical_offset, @ptrCast(&parent.vertical_offset)),
+    };
+    for (rest) |result| try testing.expectEqual(first, result);
+    return switch (first) {
+        .success => parent,
+        .no_value => null,
+        else => error.UnexpectedResult,
+    };
+}
+
+test "placement_get placement_id_namespace tells colliding numbers apart" {
+    if (comptime !build_options.kitty_graphics) return error.SkipZigTest;
+
+    var t: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(&lib.alloc.test_allocator, &t, 80, 24));
+    defer terminal_c.free(t);
+
+    // Two terminal-numbered placements (internal 0 and 1) and a client's
+    // p=1 (external 1) of the same image.
+    const cmds = "\x1b_Ga=T,q=2,f=24,s=1,v=1,i=1,C=1;AAAA\x1b\\" ++
+        "\x1b_Ga=p,q=2,i=1,C=1\x1b\\" ++
+        "\x1b_Ga=p,q=2,i=1,p=1,C=1\x1b\\";
+    terminal_c.vt_write(t, cmds.ptr, cmds.len);
+
+    var graphics: KittyGraphics = undefined;
+    try testing.expectEqual(Result.success, terminal_c.get(t, .kitty_graphics, @ptrCast(&graphics)));
+    var iter: PlacementIterator = null;
+    try testing.expectEqual(Result.success, placement_iterator_new(&lib.alloc.test_allocator, &iter));
+    defer placement_iterator_free(iter);
+    try testing.expectEqual(Result.success, get(graphics, .placement_iterator, @ptrCast(&iter)));
+
+    var internal_ids: u32 = 0;
+    var external_one = false;
+    var count: usize = 0;
+    while (placement_iterator_next(iter)) {
+        count += 1;
+        const key = try testIteratorKey(iter);
+        try testing.expectEqual(1, key.image_id);
+        switch (key.namespace) {
+            .internal => internal_ids |= @as(u32, 1) << @intCast(key.placement_id),
+            .external => {
+                try testing.expectEqual(1, key.placement_id);
+                external_one = true;
+            },
+        }
+    }
+    try testing.expectEqual(3, count);
+    try testing.expectEqual(0b11, internal_ids);
+    try testing.expect(external_one);
+}
+
+test "placement_get reports a relative placement's parent link" {
+    if (comptime !build_options.kitty_graphics) return error.SkipZigTest;
+
+    var t: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(&lib.alloc.test_allocator, &t, 80, 24));
+    defer terminal_c.free(t);
+
+    // Image 1 placed virtually (external 1); image 2 relative to it at
+    // (2, -1) as external 1; image 3 relative to image 2 at (1, 3), with
+    // no p= of its own; image 4 on a pin (external 2) and image 5
+    // relative to it without Q=, at (-4, 0).
+    const cmds = "\x1b_Ga=T,U=1,q=2,f=24,s=1,v=1,i=1,p=1;AAAA\x1b\\" ++
+        "\x1b_Ga=t,q=2,f=24,s=1,v=1,i=2;AAAA\x1b\\" ++
+        "\x1b_Ga=p,q=2,i=2,p=1,P=1,Q=1,H=2,V=-1,C=1\x1b\\" ++
+        "\x1b_Ga=t,q=2,f=24,s=1,v=1,i=3;AAAA\x1b\\" ++
+        "\x1b_Ga=p,q=2,i=3,P=2,Q=1,H=1,V=3,C=1\x1b\\" ++
+        "\x1b_Ga=T,q=2,f=24,s=1,v=1,i=4,p=2,C=1;AAAA\x1b\\" ++
+        "\x1b_Ga=t,q=2,f=24,s=1,v=1,i=5;AAAA\x1b\\" ++
+        "\x1b_Ga=p,q=2,i=5,P=4,H=-4,C=1\x1b\\";
+    terminal_c.vt_write(t, cmds.ptr, cmds.len);
+
+    var graphics: KittyGraphics = undefined;
+    try testing.expectEqual(Result.success, terminal_c.get(t, .kitty_graphics, @ptrCast(&graphics)));
+    var iter: PlacementIterator = null;
+    try testing.expectEqual(Result.success, placement_iterator_new(&lib.alloc.test_allocator, &iter));
+    defer placement_iterator_free(iter);
+    try testing.expectEqual(Result.success, get(graphics, .placement_iterator, @ptrCast(&iter)));
+
+    var seen: u32 = 0;
+    while (placement_iterator_next(iter)) {
+        const key = try testIteratorKey(iter);
+        seen |= @as(u32, 1) << @intCast(key.image_id);
+        const parent = try testIteratorParent(iter);
+        switch (key.image_id) {
+            1, 4 => try testing.expectEqual(null, parent),
+            2 => try testing.expectEqual(TestParent{
+                .key = .{ .image_id = 1, .placement_id = 1, .namespace = .external },
+                .horizontal_offset = 2,
+                .vertical_offset = -1,
+            }, parent.?),
+            3 => {
+                try testing.expectEqual(PlacementIdNamespace.internal, key.namespace);
+                try testing.expectEqual(TestParent{
+                    .key = .{ .image_id = 2, .placement_id = 1, .namespace = .external },
+                    .horizontal_offset = 1,
+                    .vertical_offset = 3,
+                }, parent.?);
+            },
+            5 => try testing.expectEqual(TestParent{
+                .key = .{ .image_id = 4, .placement_id = 2, .namespace = .external },
+                .horizontal_offset = -4,
+                .vertical_offset = 0,
+            }, parent.?),
+            else => return error.UnexpectedPlacement,
+        }
+    }
+    try testing.expectEqual(0b111110, seen);
+}
+
+test "placement_get parent data on an unpositioned iterator returns invalid_value" {
+    if (comptime !build_options.kitty_graphics) return error.SkipZigTest;
+
+    var t: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(&lib.alloc.test_allocator, &t, 80, 24));
+    defer terminal_c.free(t);
+    var graphics: KittyGraphics = undefined;
+    try testing.expectEqual(Result.success, terminal_c.get(t, .kitty_graphics, @ptrCast(&graphics)));
+
+    var image_id: u32 = 0;
+    try testing.expectEqual(Result.invalid_value, placement_get(null, .parent_image_id, @ptrCast(&image_id)));
+    var iter: PlacementIterator = null;
+    try testing.expectEqual(Result.success, placement_iterator_new(&lib.alloc.test_allocator, &iter));
+    defer placement_iterator_free(iter);
+    try testing.expectEqual(Result.success, get(graphics, .placement_iterator, @ptrCast(&iter)));
+    // not positioned on a placement
+    try testing.expectEqual(Result.invalid_value, placement_get(iter, .parent_image_id, @ptrCast(&image_id)));
+    var namespace: PlacementIdNamespace = .internal;
+    try testing.expectEqual(Result.invalid_value, placement_get(iter, .placement_id_namespace, @ptrCast(&namespace)));
+}
