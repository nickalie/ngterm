+        let mut event_loop = calloop::EventLoop::<'static, ()>::try_new().unwrap();
+        let mut clipboard = Clipboard::new(connection, event_loop.handle());
+        let binary: Vec<u8> = (0..=255).collect();
+        clipboard.set_representations(
