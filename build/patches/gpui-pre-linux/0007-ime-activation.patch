+#[derive(Default)]
+struct ImeState {
+    last_rectangle: Option<ImeCursorRectangle>,
+    // text-input-v3 Done acknowledges the number of commits on this object, not prior Done events.
+    commit_serial: u32,
+}
+
+impl ImeState {
+    fn commit(&mut self, text_input: &impl ImeCursorRectangleSink) {
+        text_input.commit_ime_state();
+        self.commit_serial = self.commit_serial.wrapping_add(1);
+    }
+}
