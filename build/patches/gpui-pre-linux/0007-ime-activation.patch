+
+// Enable must resend even an unchanged rectangle: the new input-method session has no state.
+fn enable_ime_cursor_rectangle(
+    text_input: &impl ImeCursorRectangleSink,
+    ime_state: &mut ImeState,
+    bounds: Option<Bounds<Pixels>>,
+) {
+    ime_state.last_rectangle = bounds.map(ImeCursorRectangle::from);
+    if let Some(rectangle) = ime_state.last_rectangle {
+        set_ime_cursor_rectangle(text_input, rectangle);
+    }
+    ime_state.commit(text_input);
 }
 
 fn set_ime_cursor_rectangle_after_done(
     text_input: &impl ImeCursorRectangleSink,
-    last_ime_cursor_rectangle: &mut Option<ImeCursorRectangle>,
