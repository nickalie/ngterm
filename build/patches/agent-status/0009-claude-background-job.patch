Find the pane of a Claude Code background job. Claude Code can carry a conversation on in a background process of its daemon (/background, or a Left arrow at its empty prompt), whose hooks inherit the daemon's NGTERM_* and not the pane's: the Claude status adapter, the mail hook and the restore adapter, in both forms, run themselves again through `ngtermctl agent rerun` when CLAUDE_JOB_DIR is set, as the pane whose agent record holds the conversation, or do nothing. Applied after 0008-ngswap-restore.patch.

diff --git a/ngterm-agent-mail.ps1 b/ngterm-agent-mail.ps1
index e2a0962..e7307cb 100644
--- a/ngterm-agent-mail.ps1
+++ b/ngterm-agent-mail.ps1
@@ -14,6 +14,30 @@
 # ngtermctl resolution: $env:NGTERMCTL, else the path the installer bakes in ($NgtermctlBaked), else `ngtermctl` on
 # PATH.
 
+# A background job of Claude Code's daemon (CLAUDE_JOB_DIR is set: Claude Code moves a conversation there on
+# /background or on a Left arrow at its empty prompt) has the daemon's NGTERM_*, which name the pane the daemon was
+# started in: a session long gone, or another one's. `ngtermctl agent rerun` finds the pane that holds this
+# conversation from the payload and runs this hook again as that pane; with none it runs nothing, silently.
+if ($env:CLAUDE_JOB_DIR -and -not $env:NGTERM_AGENT_LOCATED) {
+  $rerunStatus = 0
+  try {
+    $rerunCtl = $env:NGTERMCTL
+    if (-not $rerunCtl) { $rerunCtl = Get-Variable -Name NgtermctlBaked -ValueOnly -ErrorAction SilentlyContinue }
+    if (-not $rerunCtl) { $rerunCtl = 'ngtermctl' }
+    $rerun = @('agent', 'rerun', 'claude')
+    if ($env:NGTERM_SOCKET) { $rerun += @('--socket', $env:NGTERM_SOCKET) }
+    $rerun += @('--', (Get-Process -Id $PID).Path, '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass',
+      '-File', $PSCommandPath) + @($args)
+    if ([Console]::IsInputRedirected) {
+      $rerunInput = [System.IO.StreamReader]::new([Console]::OpenStandardInput(), [System.Text.UTF8Encoding]::new($false))
+      $OutputEncoding = [System.Text.UTF8Encoding]::new($false)
+      $rerunInput.ReadToEnd() | & $rerunCtl @rerun
+      $rerunStatus = $LASTEXITCODE
+    }
+  } catch { }
+  exit $rerunStatus
+}
+
 if (-not $env:NGTERM_SESSION_ID -or -not $env:NGTERM_PANE_ID) { exit 0 }
 
 $ngtermctl = 'ngtermctl'
diff --git a/ngterm-agent-mail.sh b/ngterm-agent-mail.sh
index 24ef4ac..08671ea 100755
--- a/ngterm-agent-mail.sh
+++ b/ngterm-agent-mail.sh
@@ -24,6 +24,17 @@
 # ngtermctl resolution: $NGTERMCTL, else the path the installer bakes in, else `ngtermctl` on PATH.
 set -u
 
+# A background job of Claude Code's daemon (CLAUDE_JOB_DIR is set: Claude Code moves a conversation there on
+# /background or on a Left arrow at its empty prompt) has the daemon's NGTERM_*, which name the pane the daemon was
+# started in: a session long gone, or another one's. `ngtermctl agent rerun` finds the pane that holds this
+# conversation from the payload and runs this hook again as that pane; with none it runs nothing, silently.
+if [ -n "${CLAUDE_JOB_DIR:-}" ] && [ -z "${NGTERM_AGENT_LOCATED:-}" ]; then
+  command -v "${NGTERMCTL:-ngtermctl}" >/dev/null 2>&1 || exit 0
+  rerun=(agent rerun claude)
+  [ -n "${NGTERM_SOCKET:-}" ] && rerun+=(--socket "$NGTERM_SOCKET")
+  exec "${NGTERMCTL:-ngtermctl}" "${rerun[@]}" -- "${BASH:-bash}" "$0" "$@"
+fi
+
 [ -n "${NGTERM_SESSION_ID:-}" ] && [ -n "${NGTERM_PANE_ID:-}" ] || exit 0
 
 args=(agent mail "$@")
