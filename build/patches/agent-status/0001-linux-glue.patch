This build's changes to upstream's agterm/Resources/agent-status from before it took the name ngterm: the wrappers
and plugins call the CLI as `ngtermctl`; the Claude adapter keeps a Stop with background work in flight `active`
(the row pulses until that work ends or SessionEnd fires); the Codex adapter reads its payload with python3 or jq
where macOS's plutil is missing and finds awk, sed, tr and tail on PATH. sync-resources.sh reapplies this series to
upstream's tree after every sync; a hunk an upstream release conflicts with is merged by hand, keeping these.

diff --git a/agterm-agent-status.sh b/agterm-agent-status.sh
index e2f70c0..887bab8 100755
--- a/agterm-agent-status.sh
+++ b/agterm-agent-status.sh
@@ -7,7 +7,7 @@
 #   agterm-agent-status.sh idle              # clear the indicator
 #
 # States: idle | active | completed | blocked. An optional --blink / --auto-reset
-# (and any further args) is forwarded verbatim to `agtermctl session status`.
+# (and any further args) is forwarded verbatim to `ngtermctl session status`.
 #
 # Outside agterm this is a silent no-op, so it is safe to call from any hook.
 #
@@ -15,12 +15,12 @@
 # (Claude Code injects a UserPromptSubmit/SessionStart hook's stdout into the
 # prompt context) and it always exits 0 (a non-zero exit can block the turn).
 #
-# agtermctl resolution order (the binary that talks to the control socket):
+# ngtermctl resolution order (the binary that talks to the control socket):
 #   1. $AGTERMCTL — an explicit override the caller set.
 #   2. the absolute bundled-binary path the installer bakes in: the installer
-#      rewrites the AGTERMCTL default below to agterm.app's Contents/MacOS/agtermctl,
+#      rewrites the AGTERMCTL default below to the app's bundled bin/ngtermctl,
 #      so the hook fires even when the CLI was never symlinked into PATH.
-#   3. `agtermctl` on PATH — the fallback when no override was set and the baked
+#   3. `ngtermctl` on PATH — the fallback when no override was set and the baked
 #      path no longer exists, which is what a bundle moved since the install leaves
 #      behind (installing from the mounted DMG bakes a /Volumes path, dead on eject).
 set -u
@@ -37,18 +37,18 @@ shift
 # per-surface token). the role can go stale — a split survivor promoted into the main pane
 # keeps its baked `right` — so we also forward the token as --pane-id, which the app resolves
 # to the surface's CURRENT slot and lets override the stale role (#199). both are validated
-# agtermctl-side, so pass them through verbatim. the ${arr[@]+..} guard keeps the empty-array
+# ngtermctl-side, so pass them through verbatim. the ${arr[@]+..} guard keeps the empty-array
 # expansion safe under `set -u` on bash 3.2.
 pane_args=()
 [ -n "${AGTERM_PANE:-}" ] && pane_args+=(--pane "$AGTERM_PANE")
 [ -n "${AGTERM_PANE_ID:-}" ] && pane_args+=(--pane-id "$AGTERM_PANE_ID")
 
 if [ -n "${AGTERM_SOCKET:-}" ]; then
-  "${AGTERMCTL:-agtermctl}" session status "$state" \
+  "${AGTERMCTL:-ngtermctl}" session status "$state" \
     --target "$AGTERM_SESSION_ID" --socket "$AGTERM_SOCKET" \
     "${pane_args[@]+"${pane_args[@]}"}" "$@" >/dev/null 2>&1 || true
 else
-  "${AGTERMCTL:-agtermctl}" session status "$state" \
+  "${AGTERMCTL:-ngtermctl}" session status "$state" \
     --target "$AGTERM_SESSION_ID" "${pane_args[@]+"${pane_args[@]}"}" "$@" >/dev/null 2>&1 || true
 fi
 exit 0
diff --git a/agterm-claude-status.sh b/agterm-claude-status.sh
index 30825d2..26c0bd7 100755
--- a/agterm-claude-status.sh
+++ b/agterm-claude-status.sh
@@ -16,8 +16,16 @@
 #
 # It fails OPEN (reports) whenever the chain is unreadable or severed, e.g. a detached worker whose
 # spawner already exited: a missed guard is the behavior without this adapter, while a false silence
-# is a bug with no symptom. The argv is forwarded to the shared wrapper verbatim, so the adapter adds
-# a guard and changes nothing else; it never reads stdin, so a payload another hook wants is intact.
+# is a bug with no symptom. The argv is forwarded to the shared wrapper verbatim, with one exception:
+#
+# A turn can end with work still in flight, a background shell, subagent or monitor that wakes the
+# agent again when it is done. Claude Code's Stop payload lists that work in `background_tasks` (empty
+# when nothing is in flight), so a Stop that would post `completed` posts `active --blink` instead and
+# the row keeps pulsing until a Stop with nothing in flight, or the SessionEnd hook the installer adds
+# when the agent quits first. Upstream's stock Stop goes green at once and covers this case only in its
+# truthful-agent-lights cookbook recipe. Only a `completed` call reads
+# stdin, where Claude Code writes the payload as JSON; a key quoted inside a string value is escaped
+# (`\"background_tasks\"`), so the match cannot hit the last assistant message.
 set -u
 
 [ -n "${AGTERM_SESSION_ID:-}" ] || exit 0
@@ -81,4 +89,14 @@ for _ in 1 2 3 4 5 6 7 8; do
   p=$ppid
 done
 
+if [ "${1:-}" = completed ] && [ ! -t 0 ]; then
+  payload=
+  IFS= read -r -d '' -t 2 payload || true # EOF ends the read: the payload carries no NUL
+  stop_re='"hook_event_name"[[:space:]]*:[[:space:]]*"Stop"'
+  in_flight_re='"background_tasks"[[:space:]]*:[[:space:]]*\[[[:space:]]*\{'
+  if [[ $payload =~ $stop_re ]] && [[ $payload =~ $in_flight_re ]]; then
+    exec "$status_wrapper" active --blink
+  fi
+fi
+
 exec "$status_wrapper" "$@"
diff --git a/agterm-codex-status.sh b/agterm-codex-status.sh
index 6395bd8..0dfdc06 100755
--- a/agterm-codex-status.sh
