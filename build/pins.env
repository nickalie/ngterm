# Native build pins, sourced by scripts/build-ghostty-vt.sh, scripts/build-weston.sh, scripts/fetch-wpe.sh,
# scripts/fetch-lavapipe.sh, scripts/fetch-fonts.sh, scripts/gen-wpe-bindings.sh, scripts/gen-ghostty-config-keys.sh
# and scripts/build-msi.sh.
#
# Every LIBGHOSTTY_VT_* line feeds the libghostty-vt prefix key (the library's source and Ghostty's resources), every
# WPE_* line the WPE WebKit one, every LAVAPIPE_* line the lavapipe one, every WESTON_* line the weston one, every GIR_*
# line the gir one and every FONTS_* line the terminal fonts one, so a pin of one build never rebuilds another.
# Zig builds libghostty-vt alone: its pin is the repository's `minimum_zig_version` at its revision, with
# ziglang.org's sums (download/index.json) for the release archives of Linux, macOS and Windows.

# Ghostty, the one Ghostty pin: libghostty-vt, its VT library behind its official C API (include/ghostty/vt.h), which
# ngterm's terminal drives, and its resources at the same revision (terminfo, themes, shell integration), which
# scripts/build-ghostty-vt.sh vendors beside it; the config keys ngterm-core counts diagnostics against
# (scripts/gen-ghostty-config-keys.sh) are read at this revision too. It follows ghostty main, not upstream agterm's
# GHOSTTY_REV (upstream's macOS app links the full libghostty at v0.36.0's 683d8db, which lacks the vt API the app needs:
# search.h, PROGRAM_STATUS, SEMANTIC_PROMPT, the scrollback use-after-free fix): 2026-10-13, merge #14691, every
# build-libghostty-vt* CI job green. Its patches (build/patches/ghostty-vt/, each listed in its README.md) add C API
# the app needs and ghostty main lacks, and carry recorded fixes and parity behaviors. A bump (or a patch change)
# regenerates the bindings (scripts/gen-ghostty-vt-bindings.sh) and the config keys, and is a change of its own.
# The sha256 is the source archive's (codeload tar.gz of the commit).
LIBGHOSTTY_VT_REPO="https://github.com/ghostty-org/ghostty"
LIBGHOSTTY_VT_REV="81598385d608dda4946093d6d6a234d204a2f225"
LIBGHOSTTY_VT_SHA256="1bb165d1e9458c8694370039cc1a8f2a2958929760bb80f6251499158ad6b694"
LIBGHOSTTY_VT_ZIG_VERSION="0.16.0"
# one archive per OS and arch (scripts/lib/native.sh find_zig): ziglang.org's .tar.xz on Linux and macOS, .zip on
# Windows, their sums from download/index.json (looked up 2026-10-19)
LIBGHOSTTY_VT_ZIG_SHA256_LINUX_X86_64="70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00"
LIBGHOSTTY_VT_ZIG_SHA256_LINUX_AARCH64="ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17"
LIBGHOSTTY_VT_ZIG_SHA256_MACOS_X86_64="0387557ed1877bc6a2e1802c8391953baddba76081876301c522f52977b52ba7"
LIBGHOSTTY_VT_ZIG_SHA256_MACOS_AARCH64="b23d70deaa879b5c2d486ed3316f7eaa53e84acf6fc9cc747de152450d401489"
LIBGHOSTTY_VT_ZIG_SHA256_WINDOWS_X86_64="68659eb5f1e4eb1437a722f1dd889c5a322c9954607f5edcf337bc3684a75a7e"
LIBGHOSTTY_VT_ZIG_SHA256_WINDOWS_AARCH64="aee38316ee4111717900f45dd3130145c39289e105541d737eb8c5ed653c78ef"
# the iterm2_themes package this revision's build.zig.zon declares (its Zig package hash, `zig fetch`, equals the one
# pinned there: N-V-__8AADNBBQDD4MFOa3Y7R_A8PHIeWQ1IZdOiBFZS3nZ7), the theme files it holds and three it must hold
LIBGHOSTTY_VT_THEMES_URL="https://deps.files.ghostty.org/ghostty-themes-release-20261005-151109-31756e7.tgz"
LIBGHOSTTY_VT_THEMES_SHA256="574403c123bdd892699f7894bf5f85f81ce3ca0d9af18ce9885041a8b9d1e3f0"
LIBGHOSTTY_VT_THEME_COUNT=725
LIBGHOSTTY_VT_KNOWN_THEMES=("Builtin Dark" "Catppuccin Mocha" "Dracula")

# herdr, the terminal workspace manager (Apache-2.0) whose background session server crates/ngterm-session is taken
# from: the master commit studied in docs/spikes/20261018-session-server.md (2026-10-16, v0.9.5 + 24), which every
# herdr-derived file cites as its source. Provenance and the start of a future sync only: nothing fetches
# or builds it, and no prefix key reads these lines.
HERDR_REPO="https://github.com/herdrdev/herdr"
HERDR_REV="143bf5fd4781d164260c63fe28e7dc08054ad32f"

# WPE WebKit, the engine of the GPUI frontend's HTML overlays (WPEPlatform API), at the version its spike ran. Where it
# comes from (README > WPE WebKit): the distro's `wpewebkit` where packaged (a system wpe-webkit-2.0 at least
# WPE_API_VERSION wins, see scripts/pkg-config.sh); on a rootless machine with an Arch-compatible userland, this Arch
# package (archive.archlinux.org keeps it; its pacman signature was checked when pinned) unpacked by
# scripts/fetch-wpe.sh into the vendored prefix, which needs glibc WPE_ARCH_GLIBC; in CI the same package from a
# date-pinned Arch Linux Archive snapshot inside an archlinux container. The bindings' .gir files come from this package
# too (scripts/gen-wpe-bindings.sh). Every WPE_* line feeds the vendored prefix key.
WPE_VERSION="2.54.1"
WPE_API_VERSION="2.54"
WPE_ARCH_PACKAGE_URL="https://archive.archlinux.org/packages/w/wpewebkit/wpewebkit-2.54.1-2-x86_64.pkg.tar.zst"
WPE_ARCH_PACKAGE_SHA256="2279cfe4f842b693625b7ad70b81b13fbee1022bed51f5f6319a76855b9273a9"
WPE_ARCH_GLIBC="2.44"

# gtk-rs `gir`, which generates the WPE -sys crates (scripts/gen-wpe-bindings.sh), at the 0.22 branch commit that
# generated the glib-sys 0.22 the workspace locks, with the gir-files commit glib-sys 0.22.9 was generated from and
# the Soup-3.0.gir soup3-sys 0.9.0 was generated from (soup3-rs branch v0.9). The sha256s are the source archives' and
# the .gir's. Every GIR_* line (and build/patches/gir/) feeds the key of the vendored gir binary.
GIR_REPO="https://github.com/gtk-rs/gir"
GIR_REV="f402b90c8ad678679e40011c008303b53f251619"
GIR_SHA256="3746813b3dbd9fcec47a9ae6c3a2f48bdd7898484f15be3824a21a984f95fb73"
GIR_FILES_REPO="https://github.com/gtk-rs/gir-files"
GIR_FILES_REV="f1b46c29333cc9824088838c68be8e4ad9e26495"
GIR_FILES_SHA256="5c285ecdbb8b677e9447bd127fc56a8e2987689ebb6de798c2d2099ecd8ec968"
GIR_SOUP_URL="https://gitlab.gnome.org/World/Rust/soup3-rs/-/raw/43121bc229b241b6338b62d56be1bdd164d60eea/Soup-3.0.gir"
GIR_SOUP_SHA256="18be1efe2e35df7c4a09f2886c1ad6fe311636eb404f0fb935186b0a771a92a8"

# lavapipe, Mesa's software Vulkan driver: the GPUI build renders on it, and on nothing else, in every headless run (the
# conformance harness, ngterm-gpui's process tests), never on a hardware driver. Where it comes from
# (scripts/fetch-lavapipe.sh, conformance/docs/rust-build.md > GPUI build): NGTERM_LAVAPIPE_ICD when set; else the
# distribution's package where installed (Ubuntu/Debian/Fedora `mesa-vulkan-drivers`, Arch `vulkan-swrast`; CI
# installs Ubuntu's), which wins; else, on a rootless machine with an Arch-compatible userland, this Arch package
# (archive.archlinux.org keeps it; its pacman signature, by Arch's mesa packager, was checked when pinned on
# 2026-10-15) unpacked into the vendored prefix. It links the host's libLLVM (23.1 for this build) and needs glibc
# LAVAPIPE_ARCH_GLIBC: the unpack checks that every library resolves. Every LAVAPIPE_* line feeds the prefix key.
LAVAPIPE_VERSION="26.2.4"
LAVAPIPE_ARCH_PACKAGE_URL="https://archive.archlinux.org/packages/v/vulkan-swrast/vulkan-swrast-1%3A26.2.4-1-x86_64.pkg.tar.zst"
LAVAPIPE_ARCH_PACKAGE_SHA256="5f7128c7cd46af307ea9218957c8cdbf6cfae8a580cf8e269929f1d1df189cb9"
LAVAPIPE_ARCH_GLIBC="2.38"

# weston, the headless compositor every suite instance draws into, where the system's is too old for the GPUI build:
# GPUI needs a `wl_seat`, which headless weston offers only with `--fake-seat`, new in weston 15.0 (Ubuntu 24.04 ships
# 13). scripts/build-weston.sh builds this release (headless backend, GL renderer, desktop shell, nothing else) into
# the vendored prefix, with the two dependencies Ubuntu 24.04 has too old (wayland-protocols >= 1.46,
# libdisplay-info >= 0.2) built in as meson subprojects from these tarballs, and no download during the build. The
# sha256s are the release tarballs' (each matches its published .sha256sum; the GPG signatures, weston's by Marius
# Vlad, the other two by Simon Ser, were checked good when pinned on 2026-10-15). Every WESTON_* line feeds the key.
WESTON_VERSION="15.0.1"
WESTON_URL="https://gitlab.freedesktop.org/-/project/120/uploads/1bafc21bf4f93deeba0936829d7709cb/weston-15.0.1.tar.xz"
WESTON_SHA256="551d039bfb0c837ba5a4d027cdb8ee16bded0eedb789821f8025d8a64b791f6d"
WESTON_WAYLAND_PROTOCOLS_VERSION="1.49"
WESTON_WAYLAND_PROTOCOLS_URL="https://gitlab.freedesktop.org/-/project/2891/uploads/7ed597f0cad076a17fe36f8860596f8c/wayland-protocols-1.49.tar.xz"
WESTON_WAYLAND_PROTOCOLS_SHA256="ec4c8f74942d6dff7ace8b4ce4764f0ef9ff618a935d974ea77edee2ad240b14"
WESTON_DISPLAY_INFO_VERSION="0.3.0"
WESTON_DISPLAY_INFO_URL="https://gitlab.freedesktop.org/-/project/14497/uploads/a7e427e2c5ef474032a87459443b7982/libdisplay-info-0.3.0.tar.xz"
WESTON_DISPLAY_INFO_SHA256="6ae77cd937f9cf7d1321d35c116062c4911e8447010a6a713ac4286f7a9d5987"

# The fonts Ghostty embeds, for the GPUI frontend's terminal (ngterm-gpui embeds them at build time): JetBrains Mono,
# the face used when `font-family` is unset, and Symbols Nerd Font, every family's symbol fallback. They are the
# package deps of the Ghostty at LIBGHOSTTY_VT_REV (build.zig.zon `jetbrains_mono`, `nerd_fonts_symbols_only`); the
# sha256s are the archives', whose Zig package hashes (`zig fetch`) equal the ones build.zig.zon pins
# (N-V-__8AAIC5lwAVPJJzxnCAahSvZTIlG-HhtOvnM1uh-66x, N-V-__8AAMVLTABmYkLqhZPLXnMl-KyN38R8UVYqGrxqO26s). JetBrains Mono
# is under the SIL Open Font License 1.1, Symbols Nerd Font under MIT; both licenses are kept in the prefix.
FONTS_JETBRAINS_MONO_URL="https://deps.files.ghostty.org/JetBrainsMono-2.304.tar.gz"
FONTS_JETBRAINS_MONO_SHA256="c57a691e8b82ad098b5963f3959032e4038f391087af7715885ba59046105cc4"
FONTS_NERD_SYMBOLS_URL="https://deps.files.ghostty.org/NerdFontsSymbolsOnly-3.4.0.tar.gz"
FONTS_NERD_SYMBOLS_SHA256="1164d1b956d4bde248d7b2f0998c43cc94f5202431a1564a793895b1e73b0d04"

# The WiX Toolset, which builds the Windows installer (scripts/build-msi.sh, packaging/windows/ngterm.wxs): the `wix`
# .NET tool from nuget.org, installed into the vendor root by `dotnet tool install`. 5.0.2 (2024-10) is the last
# release under the plain Microsoft Reciprocal License; 6.x and 7.x ship under the Open Source Maintenance Fee EULA
# (a fee for revenue-generating users, an explicit acceptance in 7.x), which is the user's call to take. The source's
# schema (wixtoolset.org/schemas/v4/wxs) is the same in 5, 6 and 7, so a later bump changes this line (and, for 7, the
# EULA's acceptance) only.
WIX_VERSION="5.0.2"
