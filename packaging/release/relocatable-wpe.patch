+// Ubuntu's bundled GnuTLS has a Debian-specific default CA path. Use the
+// host distro's trust anchors when that file is absent, retaining verification.
+static void configureReleaseSystemTrust()
+{
+    if (g_file_test("/etc/ssl/certs/ca-certificates.crt", G_FILE_TEST_IS_REGULAR))
+        return;
+    const char* const candidates[] = {
+        "/etc/pki/tls/certs/ca-bundle.crt",
+        "/etc/ssl/ca-bundle.pem",
+        "/etc/ssl/cert.pem",
+        "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem",
+        "/var/lib/ca-certificates/ca-bundle.pem",
+    };
+    for (const char* file : candidates) {
+        if (!g_file_test(file, G_FILE_TEST_IS_REGULAR))
+            continue;
+        GError* error = nullptr;
+        GTlsDatabase* database = g_tls_file_database_new(file, &error);
+        if (!database) {
+            g_clear_error(&error);
+            continue;
+        }
+        g_tls_backend_set_default_database(g_tls_backend_get_default(), database);
+        g_object_unref(database);
+        return;
+    }
+}
