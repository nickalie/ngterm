<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	How .github/workflows/ios-release.yml exports the Release archive (xcodebuild -exportArchive): for App Store
	Connect, signed automatically through the App Store Connect API key the workflow passes, with the build number the
	archive already has (the release tag's commit count). It exports locally: a release's run sets destination to
	upload in its own copy, so nothing that reads this file as it is uploads anything. The team id comes from the
	workflow too (docs/ios-release.md).
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
