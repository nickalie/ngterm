# The single source of truth for formatting the Android project: ktlint (through Spotless) reads it, and so do IDEs.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
# detekt's MaxLineLength has the same limit
max_line_length = 120
# composables are named in PascalCase
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,toml,yml,yaml}]
indent_size = 2
