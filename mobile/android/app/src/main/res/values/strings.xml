  <!-- the host key: first connect and a changed key -->
  <string name="hostkey_title">Trust %1$s?</string>
  <string name="hostkey_body">This is the first connection to %1$s. Compare its host key\'s fingerprint with the one the machine shows before you trust it.</string>
  <string name="hostkey_fingerprint">Fingerprint</string>
  <string name="hostkey_check">On the machine, run</string>
  <string name="hostkey_trust">Trust and connect</string>
  <string name="hostkey_decline">Don\'t connect</string>
  <string name="hostkey_changed_title">%1$s\'s host key changed</string>
  <string name="hostkey_changed_body">%1$s offered a different host key from the one you trusted. Someone may be intercepting the connection, or the machine was reinstalled or its keys were made anew. ngterm won\'t connect until you check.</string>
  <string name="hostkey_changed_pinned">Trusted until now</string>
  <string name="hostkey_changed_offered">Offered now</string>
  <string name="hostkey_changed_advice">If you know why the key changed, remove the pinned key and confirm the new one when you connect. If you don\'t, ask whoever runs the machine before you do anything.</string>
  <string name="hostkey_keep_blocked">Back to machines</string>
  <string name="hostkey_remove_pin">Remove pinned key</string>
  <string name="hostkey_remove_title">Remove the pinned key of %1$s?</string>
  <string name="hostkey_remove_body">The next connection asks you to trust whatever key %1$s offers then. Only do this if you know why its key changed.</string>

